# Copy to .env.local and fill in. Never commit .env.local.

# One Stripe key for both checkouts (membership in app/actions/membership.ts,
# patron in app/actions/patron.ts). Both only create Checkout Sessions, so a
# restricted rk_… key with Checkout Sessions write access is enough. Empty
# keeps both buttons disabled ("Payments open soon").
STRIPE_SECRET_KEY=
# Optional: a separate key for the membership checkout only, so it can be
# revoked on its own. Falls back to STRIPE_SECRET_KEY when empty.
STRIPE_SECRET_KEY_MEMBERSHIP=

# Membership: €1,000 EUR today, then €100 EUR/month starting one month later.
# Two prices on one product, created in the Stripe dashboard:
#   STRIPE_PRICE_ID_MEMBERSHIP_1000 — €1,000 EUR, one-time (the signup fee)
#   STRIPE_PRICE_ID_MEMBERSHIP_100  — €100 EUR, recurring monthly
# Either price id empty keeps the member button disabled.
STRIPE_PRICE_ID_MEMBERSHIP_1000=
STRIPE_PRICE_ID_MEMBERSHIP_100=

# Signing secret for the Stripe webhook that mirrors members + payments into
# Neon (app/api/stripe/webhook/route.ts, tables in db/members.sql).
# Production: the endpoint registered in Stripe at /api/stripe/webhook.
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_… to paste here.
STRIPE_WEBHOOK_SECRET=

# Neon Postgres — backup store for join applications.
# Grab the pooled connection string from the Neon dashboard (or `vercel env pull`).
DATABASE_URL=

# Notion internal integration token (the CRM/CMS behind members, house rules,
# and applications). Create the integration at https://www.notion.so/my-integrations,
# copy its Internal Integration Secret, then open the "hacker bloc CRM" page in
# Notion and share it with the integration (••• → Connections → your integration)
# so it can see the members / site rules / applications databases.
# Unset is fine: the site falls back to placeholder members, hides House rules,
# and the join form writes to Neon only.
NOTION_TOKEN=
